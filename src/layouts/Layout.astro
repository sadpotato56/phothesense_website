---
// 1. Import Bootstrap trực tiếp từ thư mục vừa cài đặt
import { Icon } from 'astro-icon/components';
import 'bootstrap/dist/css/bootstrap.min.css';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/roboto-slab/400.css';
import '@fontsource/poppins/400.css';
import '@fontsource/roboto/400.css';

// Import các file CSS toàn cục
import '../styles/base.css';
import '../styles/header.css';
import '../styles/footer.css';
import HeaderHero from '../components/HeaderHero.astro';
import HeaderSubpage from '../components/HeaderSubpage.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  // image?: string;
  ogImage?: string;
  headerType?: 'hero' | 'subpage';
}

const { 
  title = "PHOTHESENSE | Local Travel Experiences & Workshops in Vietnam",
  description = "Discover authentic local experiences in Hanoi, Ninh Binh, and Sapa. Join hands-on workshops, city tours, and walking tours.",
  // image = "/picture/PTS_logo/logo.png",
  ogImage = "/picture/PTS_logo/Logo_orangeColor.png",
  
  headerType 
} = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const isHomePage = currentPath === base || currentPath === base.slice(0, -1) || currentPath === '/';
const autoHeader = isHomePage ? 'hero' : 'subpage';
const finalHeaderType = headerType ? headerType : (isHomePage ? 'hero' : 'subpage');
const absoluteOgImage = new URL(ogImage, Astro.site ?? Astro.url.origin).href;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/png" sizes="32x32" href="/picture/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/picture/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/picture/favicon/apple-touch-icon.png">
    <link rel="manifest" href="/picture/favicon/site.webmanifest">
    <meta name="theme-color" content="#1C4278">

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={Astro.url.href} />

    
    <!-- <link rel="preconnect" href="https://fonts.googleapis.com"> -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Roboto:wght@400;500&family=Roboto+Slab:wght@600;700&display=swap" rel="stylesheet"> -->
    <!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"> -->

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": "PHOTHESENSE",
      "description": "Local travel experiences and workshops in Vietnam",
      "url": "https://phothesense.github.io"
    }
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1718793789205425');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1718793789205425&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body data-header={finalHeaderType}>
    {finalHeaderType === 'hero' ? <HeaderHero /> : <HeaderSubpage />}
  

    <slot />


   <button id="scrollToTop" class="scroll-to-top">
      <Icon name="fa6-solid:chevron-up" />
    </button>

    <Footer />
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../script/script.js"></script>
    
  </body>
</html>

