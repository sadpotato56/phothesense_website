---
import { Icon } from 'astro-icon/components';
import Layout from "../../layouts/Layout.astro";
import { getCollection } from 'astro:content';
import BlogCard from '../../components/Blog_post_card.astro';

// 1. Lấy toàn bộ bài viết
const allPosts = await getCollection('blog');

// 2. Hàm parse date "DD/MM/YYYY" → Date object
const parseDate = (dateStr: string) => {
  if (dateStr.includes('/')) {
    const [day, month, year] = dateStr.split('/');
    return new Date(`${year}-${month}-${day}`);
  }
  return new Date(dateStr);
};

// 3. Hàm tính thời gian đọc (200 từ/phút)
const calculateReadTime = (text: string) => {
  const words = text.trim().split(/\s+/).length;
  return `${Math.ceil(words / 200)} Min Read`;
};

// 4. Sort mới nhất → cũ nhất, lấy 8 bài
const latestPosts = allPosts
//   .sort((a, b) => parseDate(b.data.date).valueOf() - parseDate(a.data.date).valueOf())
  .slice(0, 8);
---


<Layout title="Blog – PhotoThesense" headerType="subpage">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vietnam Travel Blog Layout</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    

    <style>

        
        /* --- 1. RESET & VARIABLES --- */
        :root {
            --font-main: 'Inter', sans-serif;
            --color-text-main: #1a1a1a;
            --color-text-sub: #555;
            --color-bg-light: #f4f4f4;
            --color-accent-pink: #ffcce6;
            --color-border: #e0e0e0;
            --spacing-container: 20px;
            --max-width: 1540px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            margin-top: 60px;
            font-family: var(--font-main);
            color: var(--color-text-main);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .container {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0 var(--spacing-container);
        }

        /* --- 2. HEADER & OVERVIEW SECTION --- */
        .section-overview {
            padding: 60px 0;
        }

        .intro-block {
            margin-bottom: 60px;
            max-width: 800px;
        }

        .intro-block h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .intro-block p {
            font-size: 1.125rem;
            color: var(--color-text-sub);
            font-weight: 300;
            line-height: 1.6;
        }

        /* Header của phần Attractions */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .section-header h2 {
            font-size: 2.25rem;
            font-weight: 700;
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .link-explore {
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .nav-arrows {
            display: flex;
            gap: 8px;
        }

        .nav-btn {
            width: 44px;
            height: 44px;
            background-color: #1f1b1b;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 20px;
            transition: color 0.3s ease, opacity 0.3s ease;
            outline: none;
        }

        .nav-btn:disabled {
            background-color: #eee;
            color: #1f1b1b;
            border: none;
            cursor: pointer;
            pointer-events: none;
        }

        .nav-btn:hover {
            background-color: #555555;
            color: white;
        }

        /* --- 3. ATTRACTIONS GRID (Carousel) --- */
        .attractions-grid {
            display: flex;
            gap: 24px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            padding: 20px 2px;
            scrollbar-width: none;     /* Firefox */
            -ms-overflow-style: none;  /* IE/Edge */
        }

        .attractions-grid::-webkit-scrollbar {
            display: none;             /* Chrome/Safari */
        }

        /* Mỗi item trong carousel — thay thế .attraction-card-link cũ */
        .carousel-item {
            /* Desktop: hiện 3.5 thẻ */
            flex: 0 0 calc((100% - (24px * 3)) / 3.5);
            min-width: calc((100% - (24px * 3)) / 3.5);
            scroll-snap-align: start;
        }

        @media (max-width: 992px) {
            /* Tablet: hiện 2.5 thẻ */
            .carousel-item {
                flex: 0 0 calc((100% - (24px * 2)) / 2.5);
                min-width: calc((100% - (24px * 2)) / 2.5);
            }
        }

        @media (max-width: 576px) {
            .attractions-grid {
                gap: 16px;
            }
            /* Mobile: hiện 1.3 thẻ */
            .carousel-item {
                flex: 0 0 75%;
                min-width: 75%;
            }
        }

        /* --- 4. PLANNING TOOLS SECTION (Info Cards) --- */
        .section-planning {
            padding: 60px 0 100px 0;
        }

        .planning-header-center {
            text-align: center;
            margin-bottom: 60px;
        }

        .sub-heading {
            display: block;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--color-text-sub);
            margin-bottom: 10px;
        }

        .planning-header-center h2 {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .tool-card {
            background-color: var(--color-bg-light);
            padding: 40px 32px;
            display: flex;
            flex-direction: column;
            min-height: 320px;
            transition: transform 0.3s;
        }

        .tool-card:hover {
            transform: translateY(-5px);
            background-color: #c0dbec;
        }

        .tool-icon {
            width: 32px;
            height: 32px;
            margin-bottom: 24px;
            color: #1a1a1a;
        }

        .tool-title {
            font-size: 1rem;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 12px;
            letter-spacing: 0.5px;
        }

        .tool-desc {
            font-size: 0.95rem;
            color: #333;
            line-height: 1.6;
            margin-bottom: 30px;
            flex-grow: 1;
        }

        .tool-footer {
            border-top: 1px solid rgba(0,0,0,0.1);
            padding-top: 20px;
        }

        .link-read-more {
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 1.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* --- 5. RESPONSIVE --- */
        @media (max-width: 1024px) {
            .tools-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .intro-block h1, .section-header h2, .planning-header-center h2 {
                font-size: 2rem;
            }
        }

        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
            .section-header {
                flex-direction: column;
                align-items: flex-start;
            }
            .header-controls {
                width: 100%;
                justify-content: space-between;
            }
        }

        .font-label { font-family: 'Inter', sans-serif; }
        .font-title { font-family: 'Libre Baskerville', serif; }
    </style>

<body>

    <main class="container">
        
        <section class="section-overview">
            <div class="intro-block">
                <h1>Vietnam</h1>
                <p>A land of staggering natural beauty and cultural complexities, of dynamic megacities and hill-tribe villages, Vietnam is unforgettably compelling.</p>
            </div>

            <div class="section-header">
                <h2>Latest stories from Vietnam</h2>
                <div class="header-controls">
                    <a href="../blog/all" class="link-explore">Explore All</a>
                    <div class="nav-arrows">
                        <button class="nav-btn" id="prevStory">←</button>
                        <button class="nav-btn" id="nextStory">→</button>
                    </div>
                </div>
            </div>

            <!-- CAROUSEL: Tự động render từ các file .mdx trong src/content/blog/ -->
            <div class="attractions-grid">
                {latestPosts.map((post) => (
                    <div class="carousel-item">
                        <BlogCard
                            title={post.data.title}
                            date={post.data.date}
                            readTime={calculateReadTime(post.body)}
                            location={post.data.category}
                            image={post.data.thumbnail}
                            url={`/blog/${post.slug}`}
                        />
                    </div>
                ))}
            </div>

        </section>

        <section class="section-planning">
