                    <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    <h3 class="tool-title">Best Things to Do</h3>
                    <p class="tool-desc">Experience the best of Vietnam with our pick of the top things to do.</p>
                    <div class="tool-footer">
                        <a href="#" class="link-read-more">Read Full Article →</a>
                    </div>
                </article>

                <article class="tool-card">
                    <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <h3 class="tool-title">Best Places to Visit</h3>
                    <p class="tool-desc">Plan your travels in Vietnam with our pick of the best places to visit.</p>
                    <div class="tool-footer">
                        <a href="#" class="link-read-more">Read Full Article →</a>
                    </div>
                </article>

                <article class="tool-card">
                    <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
