                        <a href="#" class="link-read-more">Read Full Article →</a>
                    </div>
                </article>

                <article class="tool-card">
                    <svg class="tool-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M21 9H3"></path><path d="M12 14h.01"></path></svg>
                    <h3 class="tool-title">Money & Cost</h3>
